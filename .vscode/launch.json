{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug ESLint",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/.bin/eslint",
      "args": ["src/**/*.{ts,tsx}"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    }
  ]
}
